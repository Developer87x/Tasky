{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
  ,

    "ConnectionStrings": {
    "ProjectDbStr": "Host=postgres;Port=5432;Database=ProjectsDb;Username=postgres;Password=postgres"
  },
    "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/identities-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
