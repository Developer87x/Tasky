{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "tasky-identity-api",
    "Secret": "0lG5PJooqnBu9hylNKrJR5mMzrQrUL7j5ZPxjVx4qdPNRfUxOn4jI+y5kJDbZbRRedAQO9C0i41Pgxew3U2Q5w==",
    "Audience": ["tasky-identities-api", "tasky-projects-api"]
  },
  "ReverseProxy": {
    "Routes": {
      "identities-public-route": {
        "ClusterId": "identities-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/identities/api/Authenticate/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/identities" }]
      },
      "identities-secured-route": {
        "ClusterId": "identities-cluster",
        "Order": 1,
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/identities/api/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/identities" }]
      },
      "projects-admin-route": {
        "ClusterId": "project-cluster",
        "Order": 0,
        "AuthorizationPolicy": "AdministratorsOnly",
        "Match": { "Path": "/project/api/Test/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/project" }]
      },
      "project-route": {
        "ClusterId": "project-cluster",
        "Order": 1,
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/project/api/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/project" }]
      }
    },
    "Clusters": {
      "identities-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://tasky-identities-service/" }
        }
      },
      "project-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://tasky-projects-service/" }
        }
      }
    }
  }
}
